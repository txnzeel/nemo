# Configuration template only. No account/connection has been verified.
nemo:
  target: snowflake
  outputs:
    snowflake:
      type: snowflake
      account: "{{ env_var('NEMO_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('NEMO_SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('NEMO_SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      database: "{{ env_var('NEMO_SNOWFLAKE_DATABASE') }}"
      warehouse: "{{ env_var('NEMO_SNOWFLAKE_WAREHOUSE') }}"
      role: NEMO_TRANSFORM
      schema: ANALYTICS
      threads: 1
      session_parameters:
        TIMEZONE: UTC
